# Jobs-Finder verified profile
# Copy this file to profile.yaml and edit only with verified facts.
# The product can tailor wording, but it must not invent applicant facts.
#
# ---------------------------------------------------------------------------
# THE ONE VERIFICATION RULE, used identically everywhere in this file and by
# the whole product (profile evidence, matching, and generated documents):
#
#   A claim only counts as VERIFIED when the specific `verified: true` field
#   that sits next to THAT claim is set to the literal value `true`.
#
#   - `verified` missing, `verified: false`, or any non-boolean value (e.g.
#     the text "true", "yes", or the number 1) is NOT verified.
#   - A value simply being present/non-empty does NOT make it verified.
#   - Importing a CV never sets any `verified: true` field by itself -- it
#     only ever produces a DRAFT for you to review and confirm by hand (or
#     via the dashboard's "Mark verified" buttons, which only ever flip one
#     of these exact flags after you explicitly confirm it).
#   - An unverified claim is treated as "Needs verification": it is shown to
#     you for review, but it can never satisfy a hard job requirement and is
#     never printed as a confirmed credential in a generated CV/cover letter.
#
# There are TWO kinds of `verified: true` fields below:
#   (A) A flag that sits beside ONE specific claim or block and confirms only
#       that claim/block (e.g. `personal.verification.gender`,
#       `personal.verification.email`, `medical_education[].verified`,
#       `license_registration.verified`, `medical_exit_exam.verified`, each
#       `languages[].verified`, each `work_history[].verified`). Setting it
#       to `true` confirms exactly that fact/block and nothing else.
#   (B) A small number of plain scalar number fields that have NO sibling
#       `verified` flag at all (`clinical_experience.years`,
#       `ngo_humanitarian_experience.years`). These are the one deliberate
#       exception: because you type the number directly, and a CV import
#       NEVER fills them in (it always leaves them blank), simply entering a
#       real number here already is your confirmation -- do not type a
#       number you have not personally verified.
# ---------------------------------------------------------------------------

personal:
  first_name: Jane         # Placeholder -- replace with your own details.
  last_name: Doe
  email: applicant@example.org
  phone: "+93 00 000 0000"
  location: Kabul, Afghanistan
  nationality: Afghan
  gender: ""   # Optional; only used for explicit gender-restricted vacancies.
  linkedin: ""
  professional_title: ""  # e.g. your current reviewed professional identity/title.
  # Confirm personal facts one field at a time. Importing a CV can fill in
  # name/email/phone automatically, but it NEVER sets these flags. Only the
  # specific fields below with literal `true` can be used as verified evidence
  # for hard requirements such as gender, nationality, location/residency, or
  # contact readiness. Confirming email does not verify gender; confirming
  # nationality does not verify phone, etc.
  verified: false   # Legacy block flag; leave false in new profiles and use per-field flags below.
  verification:
    first_name: false
    last_name: false
    email: false
    phone: false
    location: false
    nationality: false
    gender: false
    linkedin: false
    professional_title: false

resume_path: ""  # Optional local CV/PDF path; profile.yaml remains source of truth.

medical_education:
  - degree: "Needs verification"
    institution: "Needs verification"
    graduation_year: "Needs verification"
    # `verified: true` confirms this ONE medical_education entry (the degree
    # claim above, and only that claim) -- it does not confirm
    # institution/graduation_year if you leave those as placeholders.
    verified: false   # Set to true only once you have personally confirmed this.

license_registration:
  authority: "Needs verification"   # e.g. your medical registration authority. Do not invent.
  number: ""        # Do not invent.
  issue_date: ""    # Do not invent.
  expiry_date: ""   # Do not invent.
  status: "Needs verification"
  # `verified: true` confirms you hold a genuine, current medical
  # license/registration as described by `status`/`authority` above.
  verified: false     # Set to true only once you have personally confirmed this.

medical_exit_exam:
  status: "Needs verification"
  # `verified: true` confirms you have genuinely completed the Medical Exit
  # Exam as described by `status` above.
  verified: false     # Set to true only once you have personally confirmed this.

clinical_experience:
  years: ""   # Add a number only when verified. This field has NO separate
              # `verified` flag (see note (B) at the top of this file): a CV
              # import never fills this in, so typing a real number here IS
              # itself your confirmation -- do not enter a number you have
              # not personally verified.
  settings: []

# Each work_history entry may include: title, organization, location, start,
# end, bullets/description, and `verified: true`. `verified: true` on an
# entry confirms that specific job's dates/title/organization/description.
# Years-of-experience evidence is only inferred from entries that are
# explicitly verified. An entry WITHOUT `verified: true` is a draft: it is
# never printed as factual experience in an employer-facing CV/cover letter
# and never satisfies an experience requirement -- it stays visible as a
# review warning until you confirm it.
# Example (left empty by default):
#   - title: Medical Doctor
#     organization: Example Clinic
#     location: Kabul
#     start: "2022-01"
#     end: Present
#     bullets: ["Clinical consultations and patient assessment"]
#     verified: true

work_history: []

# Skills follow the same single verification rule as everything else: only
# an item written as `{name: ..., verified: true}` is a confirmed competency
# that may be printed in an employer-facing CV. A plain string skill has no
# `verified` flag, so it remains a draft note: kept for your review (and
# listed in review warnings when excluded), never printed as a confirmed CV
# competency and never used to satisfy a requirement.
skills:
  medical:
    - name: "Needs verification"
      verified: false   # Set true only for skills you personally confirm.
  public_health: []
  management: []

# Each language entry needs an explicit `verified: true` (and a resolved
# level, e.g. "Native"/"Fluent"/"Professional"/"Basic" instead of "Needs
# verification") before it can satisfy a hard language requirement in
# matching, or be called "verified" in generated documents. `verified: true`
# on one language entry confirms only that language's proficiency level --
# it has no effect on the other languages listed. Until both the level is
# resolved AND verified is true, a language is NOT listed in employer-facing
# documents at all; it remains a review warning (no placeholder level text
# is ever printed, and no unverified language is claimed to an employer).
languages:
  - name: Dari
    level: "Needs verification"
    verified: false
  - name: Pashto
    level: "Needs verification"
    verified: false
  - name: English
    level: "Needs verification"
    verified: false

# Certificates/training follow the same rule as skills: only
# `{name: ..., verified: true}` items are printed as confirmed credentials
# in employer-facing documents. Plain strings stay draft/review-only.
# Example:
#   - name: IMNCI training
#     verified: true
certificates: []

ngo_humanitarian_experience:
  years: ""   # Add a number only when verified (same no-separate-flag rule
              # as clinical_experience.years above).
  organizations: []

preferences:
  roles:
    - Medical Officer
    - Medical Doctor
    - Physician
    - Public Health Officer
    - Nutrition / TSFP health roles
    - Quality of Care / Capacity Building health roles
  # These locations have no separate `verified` flag either: typing a real
  # location here (not left as "Needs verification") is itself your
  # confirmation that it is a genuine current/preferred location. A CV
  # import never fills in a real location here -- it always leaves this as
  # "Needs verification" until you edit it yourself.
  locations:
    - Kabul
    - Afghanistan
  willing_to_relocate: "Needs verification"   # Yes / No / Needs verification
  field_deployment: "Needs verification"      # Yes / No / Needs verification

sources:
  enabled: []     # Empty means use maintained active sources: ACBAR + ReliefWeb.
  disabled: []

job_sources:
  # Optional per-source overrides. Leave empty to use the canonical defaults
  # from utils/source_registry.py. Add only values you intentionally want to
  # override locally.
  acbar:
    # timeout_seconds:
    # detail_limit:        # Maximum vacancy detail pages fetched per scan.
    # max_pages:           # Bounded pagination budget (not the whole site).
    # max_detail_concurrency:
    # urls: []             # Optional pinned listing pages instead of auto-pagination.
  reliefweb:
    # timeout_seconds:
    # limit:
