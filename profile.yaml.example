    detail_limit: 30
    urls:
      - https://www.acbar.org/en/jobs
      - https://www.acbar.org/en/jobs?page=2
      - https://www.acbar.org/en/jobs?page=3
  reliefweb:
    timeout_seconds: 25
    limit: 20

safety:
  submit_applications_automatically: false
  bypass_captcha_or_login: false
