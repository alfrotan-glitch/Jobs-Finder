# Jobs-Finder profile schema documentation
# This file documents the YAML shape only. It is never runtime applicant data,
# is never copied or loaded as a fallback, and must not contain a real or
# sample applicant. The tracked repository-root profile.yaml is the single
# canonical applicant record.
# The product can tailor wording, but it must not invent applicant facts.
#
# ---------------------------------------------------------------------------
# THE ONE VERIFICATION RULE, used identically everywhere in this file and by
# the whole product (profile evidence, matching, and generated documents):
#
#   A claim only counts as VERIFIED when the specific `verified: true` field
#   that sits next to THAT claim is set to the literal value `true`.
#
#   - `verified` missing, `verified: false`, or any non-boolean value (e.g.
#     the text "true", "yes", or the number 1) is NOT verified.
#   - A value simply being present/non-empty does NOT make it verified.
#   - Importing a CV never sets any `verified: true` field by itself -- it
#     only ever produces a DRAFT for you to review and confirm by hand (or
#     via the dashboard's "Mark verified" buttons, which only ever flip one
#     of these exact flags after you explicitly confirm it).
#   - An unverified claim is treated as "Needs verification": it is shown to
#     you for review, but it can never satisfy a hard job requirement and is
#     never printed as a confirmed credential in a generated CV/cover letter.
#
# Every factual claim has an adjacent verification flag.  For example,
# `clinical_experience.verified` verifies only its stated years, and
# `medical_education[].verified` verifies only that one education entry.
# There are no inferred or presence-based verification exceptions.
# ---------------------------------------------------------------------------

personal:
  first_name: ""         # Enter your own verified details.
  last_name: ""
  email: ""
  phone: ""
  location: ""
  nationality: ""
  gender: ""   # Optional; only used for explicit gender-restricted vacancies.
  linkedin: ""
  professional_title: ""  # Your professional identity/title; confirm it with personal.verification.professional_title.
  # Confirm personal facts one field at a time. Importing a CV can fill in
  # name/email/phone automatically, but it NEVER sets these flags. Only the
  # specific fields below with literal `true` can be used as verified evidence
  # for hard requirements such as gender, nationality, location/residency, or
  # contact readiness. Confirming email does not verify gender; confirming
  # nationality does not verify phone, etc.
  verification:
    first_name: false
    last_name: false
    email: false
    phone: false
    location: false
    nationality: false
    gender: false
    linkedin: false
    professional_title: false

# CV files are preview-only imports. They are never a runtime evidence source
# and no local document path is stored in the canonical applicant profile.

medical_education: []
# Add entries only after review. `verified: true` confirms one education entry.
# Example shape, not a live profile claim:
#   - degree: MD
#     institution: Your medical university
#     start: "2013"
#     end: "2020"
#     verified: true

license_registration:
  authority: "Needs verification"   # e.g. your medical registration authority. Do not invent.
  number: ""        # Do not invent.
  issue_date: ""    # Do not invent.
  expiry_date: ""   # Do not invent.
  status: "Needs verification"
  # `verified: true` confirms you hold a genuine, current medical
  # license/registration as described by `status`/`authority` above.
  verified: false     # Set to true only once you have personally confirmed this.

medical_exit_exam:
  status: "Needs verification"
  # `verified: true` confirms you have genuinely completed the Medical Exit
  # Exam as described by `status` above. It does NOT prove a separate
  # Medical Council Exam requirement unless the vacancy itself explicitly
  # says that an exit exam is accepted/equivalent.
  verified: false     # Set to true only once you have personally confirmed this.

clinical_experience:
  years: ""   # Add only a confirmed value. Lower-bound wording such as "> 3"
              # is allowed when you know the minimum but not an exact total.
  settings: []
  verified: false  # Only literal true verifies this duration claim.

# Each work_history entry may include: title, organization, location, start,
# end, bullets/description, and `verified: true`. `verified: true` on an
# entry confirms that specific job's dates/title/organization/description.
# Years-of-experience evidence is only inferred from entries that are
# explicitly verified. An entry WITHOUT `verified: true` is a draft: it is
# never printed as factual experience in an employer-facing CV/cover letter
# and never satisfies an experience requirement -- it stays visible as a
# review warning until you confirm it.
# Entry shape (left empty by default):
#   - title: Your confirmed title
#     organization: Your confirmed organization
#     location: Your confirmed location
#     start: "YYYY-MM"
#     end: Present
#     bullets: ["Confirmed responsibility copied from your reviewed CV"]
#     verified: true
#
# `bullets`/`responsibilities` are the professional description of the role in
# the generated CV. Both keys are accepted and merged; `bullets` is a list of
# responsibilities, `description` is a single paragraph. Write each line as a
# SCOPE statement -- what the role involved -- so the CV explains the job
# rather than repeating its title. Useful dimensions per role: role scope,
# clinical/health/nutrition responsibilities, supervision, coordination,
# reporting, stakeholders, systems used (e.g. HMIS), field responsibilities,
# safeguarding responsibilities, and administrative/programme responsibilities.
#
# Keep them factual and free of numbers: no patient counts, budgets, project
# values, percentages, or invented achievements. Leave a dimension out when it
# does not describe your role. Example lines for a health/nutrition role:
#   responsibilities:
#     - Supervised health and nutrition service delivery across the project's
#       supported facilities
#     - Supported IMAM/CMAM implementation, including SAM/MAM case
#       identification and OTP service linkage
#     - Conducted field monitoring visits and reviewed service records and
#       reports to support data quality and timely HMIS reporting

work_history: []

# Skills follow the same single verification rule as everything else: only
# an item written as `{name: ..., verified: true}` is a confirmed competency
# that may be printed in an employer-facing CV. A plain string skill has no
# `verified` flag, so it remains a draft note: kept for your review (and
# listed in review warnings when excluded), never printed as a confirmed CV
# competency and never used to satisfy a requirement.
skills:
  medical: []
  public_health: []
  management: []

# Each language entry needs an explicit `verified: true` (and a resolved
# level, e.g. "Native"/"Fluent"/"Professional"/"Basic" instead of "Needs
# verification") before it can satisfy a hard language requirement in
# matching, or be called "verified" in generated documents. `verified: true`
# on one language entry confirms only that language's proficiency level --
# it has no effect on the other languages listed. Until both the level is
# resolved AND verified is true, a language is NOT listed in employer-facing
# documents at all; it remains a review warning (no placeholder level text
# is ever printed, and no unverified language is claimed to an employer).
languages: []
# Add entries only when you know the level. Example shape, not a live claim:
#   - name: English
#     level: Fluent
#     verified: true

# Certificates/training follow the same rule as skills: only
# `{name: ..., verified: true}` items are printed as confirmed credentials
# in employer-facing documents. Plain strings stay draft/review-only.
# Entry shape:
#   - name: Confirmed training name
#     verified: true
certificates: []

ngo_humanitarian_experience:
  years: ""   # Add only a confirmed value (or a confirmed lower bound, e.g. "> 3").
  organizations: []
  verified: false  # Only literal true verifies this duration claim.

preferences:
  roles: []
  # Each preferred location is a separate claim and must be explicitly
  # verified. Example: {name: Kabul, verified: true}
  locations: []
  willing_to_relocate:
    value: "Needs verification"   # Yes / No / Needs verification
    verified: false
  field_deployment:
    value: "Needs verification"   # Yes / No / Needs verification
    verified: false

sources:
  enabled: []     # Empty means use maintained active sources: ACBAR + ReliefWeb.
  disabled: []

job_sources:
  # Optional per-source operational overrides. Leave empty to use the
  # canonical defaults from utils/source_registry.py. Add only values you
  # intentionally want to override locally.
  acbar:
    # timeout_seconds:
    # max_detail_concurrency:
    # urls: []             # Optional pinned listing pages; this intentionally scoped scan is reported PARTIAL.
    # Normal ACBAR discovery follows pagination to the source's real END_REACHED
    # and processes every relevant detail page.
  reliefweb:
    # timeout_seconds:
    # limit:               # Current ReliefWeb result-page bound.

# Never place reference names, phone numbers, emails, or notes in this tracked
# profile. The normal product never releases references automatically. If the
# owner keeps a private external store, it must be outside this repository and
# may only be read after both a vacancy-specific reference requirement and
# explicit owner approval.
private_reference_boundary:
  release_requires_owner_approval: true
  external_private_store_required: true
  runtime_release_default: "NOT_RELEASED"
