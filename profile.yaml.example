# Afghan MD Job Assistant profile
# This file is the single source of truth for your facts. The app may parse your
# CV for evidence, but it will not silently add or change factual claims here.

personal:
  first_name: Your
  last_name: Name
  email: you@example.com
  phone: "+93-700-000-000"
  location: Kabul, Afghanistan
  nationality: Afghan
  gender: ""   # Optional; only used to evaluate explicit gender-restricted vacancies.
  linkedin: ""

resume_path: ./cv.pdf

medical_education:
  - degree: MD
    institution: Example Medical University
    graduation_year: 2020
    verified: true

license_registration:
  authority: Ministry of Public Health
  number: ""   # Leave blank until the exact license/registration number is verified.
  status: "Needs verification"
  verified: false

medical_exit_exam:
  status: "Needs verification"
  verified: false

clinical_experience:
  years: 0
  settings: []        # e.g. hospital, clinic, PHC, emergency, maternity

work_history:
  # - title: Medical Officer
  #   organization: Example NGO
  #   location: Kabul
  #   start: 2021-01
  #   end: Present
  #   description: Clinical consultations, reporting, HMIS, supervision.

skills:
  medical:
    - Clinical care
    - Primary health care
  public_health: []   # e.g. BPHS, EPHS, HMIS, IMNCI, IMAM, nutrition, SRHR, IPC
  management: []      # e.g. supervision, reporting, team management

languages:
  - name: Dari
    level: Native
  - name: Pashto
    level: ""
  - name: English
    level: ""

certificates: []      # e.g. IMNCI, IMAM, IPC, nutrition, HMIS
ngo_humanitarian_experience:
  years: 0
  organizations: []

preferences:
  roles:
    - Medical Officer
    - Medical Doctor
    - Physician
    - Health Officer
    - Nutrition Officer
  locations:
    - Kabul
    - Afghanistan
  preferred_locations:
    - Kabul
  willing_to_relocate: false
  field_deployment: false
  remote_only: false

# Afghanistan source registry controls the default active discovery sources.
# Edit docs/source_registry.json to add/update maintained sources safely.
source_registry:
  enabled: true
  path: docs/source_registry.json
  disabled_source_ids: []   # e.g. [wazifaha]
  enabled_source_ids: []    # optional allow-list; leave empty for registry defaults

# Legacy/source-specific overrides. Each source can fail without breaking the app.
job_sources:
  acbar:
    enabled: true
    urls:
      - https://www.acbar.org/jobs
  reliefweb:
    enabled: true
    limit: 25
    # Optional: add approved ReliefWeb API appname for API access; otherwise public HTML fallback is used.
    appname: ""
  unjobs:
    enabled: true
    limit: 50
  unicef:
    enabled: true
    limit: 25
  official_career_pages:
    # Add official organization career pages here when useful.
    # - organization: WHO
    #   url: https://careers.who.int/careersection/ex/jobsearch.ftl
    # - organization: UNICEF
    #   url: https://jobs.unicef.org/
  ats:
    greenhouse: []
    lever: []

# Generic job boards are opt-in to avoid noisy non-medical results.
search:
  generic_job_boards_enabled: false
  queries:
    - Medical Officer Afghanistan
    - Medical Doctor Afghanistan
    - Public Health Afghanistan
  locations:
    - Afghanistan
    - Kabul
  results_per_query: 25

common_answers:
  willing_to_relocate: Needs review
  earliest_start_date: Needs review
  salary_expectation: Needs review
  how_did_you_hear: Online job board
  authorized_to_work: Needs review
  require_sponsorship: Needs review

rate_limits:
  max_applications_per_day: 10
  min_delay_seconds: 60
  max_delay_seconds: 180

schedule:
  # Safe default: scan several times per day without hammering sources.
  job_watch_interval_hours: 6
  discover_interval_hours: 6      # backward-compatible alias
  score_interval_minutes: 60      # legacy unscored-job cleanup
  deadline_alert_days: [7, 3, 1]
  enabled: true

watcher:
  enabled: true
  scan_interval_hours: 6
  deadline_alert_days: [7, 3, 1]
  auto_prepare_ready_to_apply: false  # true prepares review packages automatically; never submits
  application_out_dir: documents/applications

notifications:
  new_jobs: true
  needs_verification: true
  deadline_alerts: true
  updates: true
  closed: true
  source_failures: true

email:
  enabled: false
  imap_server: imap.gmail.com
  email: ""
  app_password: ""
  check_interval_hours: 12

# AI is optional and never required for discovery, matching, or document drafts.
ai:
  enabled: false
  enable_document_refinement: false
  default_backend: claude_cli
  backends:
    claude_cli:
      timeout: 120
  components:
    resume_tailoring: claude_cli
    form_analysis: claude_cli
    email_classification: claude_cli
    profile_analysis: claude_cli
